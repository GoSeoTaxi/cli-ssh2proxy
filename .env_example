LOGIN=userLogin
PASSWORD=userPassword
SERVER=ip_or_server_address
PORT=2222
SSH_KEY=
# Optional: use SSH agent socket instead of PASSWORD/SSH_KEY
# SSH_AUTH_SOCK=/run/user/1000/ssh-agent.socket

# Format: [user:pass@]host:port or :port
SOCKS_LSN=127.0.0.1:1080
# Format: [user:pass@]host:port or :port
HTTP_LSN=127.0.0.1:8080

DNS_IPV6=false
# DNS provider: DOH_GOOGLE | DOH_CF | DNS_QUERY | DIRECT
DNS_PROVIDER=DNS_QUERY

USE_TUN=false
DEBUG=false
TIME_OUT_MONITOR_INT_SEC=15
# Max simultaneously opened SSH channels (0 disables limit)
SSH_MAX_CHANNELS=64
# Run aggressive max-channels probe (diagnostic only)
SSH_PROBE_MAX_CHANNELS=false
# Max simultaneously accepted client connections across HTTP/SOCKS/TCP (0 disables limit).
# If omitted, defaults to SSH_MAX_CHANNELS.
MAX_CLIENT_CONNS=64
# Per-IP handshake token bucket for HTTP/SOCKS (0 disables limiter).
HANDSHAKE_RPS=100
HANDSHAKE_BURST=200
# Idle TTL for per-IP buckets.
HANDSHAKE_IP_TTL_SEC=300

UDPGW_LOCAL=127.0.0.1:7300
UDPGW_REMOTE=127.0.0.1:7300
